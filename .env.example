# OAuth-токен API Вордстата (https://api.wordstat.yandex.net)
# Получение: oauth.yandex.ru + заявка на доступ к Wordstat API
YANDEX_WORDSTAT_TOKEN=

# YandexGPT — резервный LLM-провайдер (используется, если не задан DEEPSEEK_API_KEY).
# Консоль: https://console.yandex.cloud → Folder ID + API-ключ (сервисный аккаунт → API-ключ).
YANDEXGPT_API_KEY=
YANDEXGPT_FOLDER_ID=

# DeepSeek — основной LLM-провайдер. Ключ платформенный: баланс пополняет админ,
# пользователи платят за подписку и тратят тарифные лимиты, а не токены.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-4.1-flash
