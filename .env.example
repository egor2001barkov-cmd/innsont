# OAuth-токен API Вордстата (https://api.wordstat.yandex.net)
# Получение: oauth.yandex.ru + заявка на доступ к Wordstat API
YANDEX_WORDSTAT_TOKEN=

# YandexGPT — генерация статей (Article Writer, пакетная генерация).
# Консоль: https://console.yandex.cloud → Folder ID + API-ключ (сервисный аккаунт → API-ключ).
# Без этих переменных кабинет работает в demo-режиме: статьи каркасные, по шаблонам.
YANDEXGPT_API_KEY=
YANDEXGPT_FOLDER_ID=
